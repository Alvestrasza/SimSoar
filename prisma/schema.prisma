generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum FlightVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum TaskVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum SimSoarRole {
  USER
  PILOT
  MODERATOR
  ADMIN
  OWNER
}

enum FlightModerationStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

enum UnitSystemPreference {
  METRIC
  IMPERIAL
}

enum LeaderboardViewPreference {
  ALL
  MSFS
  CONDOR
  XPLANE
}

enum MapModePreference {
  STANDARD
  SATELLITE
  TERRAIN
}

enum AuditAction {
  USER_ROLE_SYNC
  USER_ROLE_UPDATE
  USER_UPDATE
  USER_DELETE
  PILOT_PROFILE_UPDATE
  FLIGHT_UPLOAD
  FLIGHT_UPDATE
  FLIGHT_APPROVE
  FLIGHT_REJECT
  FLIGHT_HIDE
  FLIGHT_DELETE
  FLIGHT_PURGE
  FLIGHT_RESTORE
  FLIGHT_IGC_REPLACE
  IGC_UPLOAD_UNBLOCK
  IGC_DOWNLOAD
  PREFERENCE_UPDATE
  PILOT_FOLLOW
  PILOT_UNFOLLOW
  FLIGHT_LIKE
  FLIGHT_UNLIKE
  FLIGHT_COMMENT_CREATE
  FLIGHT_COMMENT_DELETE
  FLIGHT_COMMENT_REPORT
  SCORING_WINDOW_UPDATE
  AIRSPACE_IMPORT
  AIRSPACE_DELETE
  FLIGHT_STORY_UPDATE
  FLIGHT_STORY_IMAGE_DELETE
  BADGE_SETTINGS_UPDATE
  CLUB_CREATE
  CLUB_UPDATE
  CLUB_DELETE
  CLUB_MEMBER_ASSIGN
  CLUB_MEMBER_REMOVE
  COMPETITION_CREATE
  COMPETITION_UPDATE
  COMPETITION_CLOSE
  COMPETITION_DELETE
  LEAGUE_CREATE
  LEAGUE_UPDATE
  LEAGUE_DELETE
  TASK_CREATE
  TASK_UPDATE
  TASK_DELETE
  CUP_IMPORT
  SEGMENT_CREATE
  SEGMENT_UPDATE
  SEGMENT_DELETE
  OAUTH_CLIENT_CREATE
  OAUTH_CLIENT_UPDATE
  OAUTH_CLIENT_REVOKE
  OAUTH_GRANT_USE
  OAUTH_GRANT_REVOKE
  OAUTH_API_WRITE
  AUTHENTICITY_KEY_REGISTER
  AUTHENTICITY_KEY_REVOKE
  AUTHENTICITY_EVIDENCE_SUBMIT
  AUTHENTICITY_APPEAL_CREATE
  AUTHENTICITY_APPEAL_REVIEW
  JOURNAL_ENTRY_CREATE
  JOURNAL_ENTRY_UPDATE
  JOURNAL_ENTRY_DELETE
}

enum ClubMemberRole {
  MEMBER
  MANAGER
}

enum CompetitionStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum CompetitionScoringRule {
  OLC_POINTS
  DISTANCE
}

enum LeagueMode {
  WEEKLY
  WEEKEND
}

enum LeagueScope {
  GLOBAL
  CLUB
}

enum LeagueRoundStatus {
  ACTIVE
  CLOSED
}

enum HomeFeedMode {
  PUBLIC
  OWN
  FOLLOWING
}

enum NotificationType {
  FLIGHT_LIKE
  FLIGHT_COMMENT
  FLIGHT_MODERATION
  FOLLOWED_PILOT_FLIGHT
}

enum UploadBatchItemStatus {
  IMPORTED
  FAILED
}

enum ScoringWindowMode {
  AUTO
  MANUAL
}

enum OAuthClientStatus {
  PENDING
  APPROVED
  SUSPENDED
  REVOKED
}

enum AuthenticityStatus {
  VERIFIED
  INCOMPLETE
  FLAGGED
  UNSUPPORTED
}

enum AuthenticityAppealStatus {
  OPEN
  ACCEPTED
  REJECTED
}

enum WindEstimateConfidence {
  LOW
  MEDIUM
  HIGH
}

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String?         @unique
  emailVerified  DateTime?
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  roles          SimSoarRole[]   @default([USER, PILOT])
  accounts       Account[]
  sessions       Session[]
  authenticators Authenticator[]
  profile        PilotProfile?
  preferences    UserPreference?
  flights        Flight[]
  following      PilotFollow[]    @relation("PilotFollowFollower")
  followers      PilotFollow[]    @relation("PilotFollowFollowing")
  flightLikes    FlightLike[]
  flightComments FlightComment[]
  commentReports FlightCommentReport[]
  notifications  Notification[]        @relation("NotificationRecipient")
  notificationsSent Notification[]     @relation("NotificationActor")
  uploadBatches     UploadBatch[]
  badges            UserBadge[]
  clubMemberships   ClubMembership[]
  competitionEntries CompetitionEntry[]
  leagueEntries      LeagueRoundEntry[]
  segmentResults     FlightSegmentResult[]
  tasks              FlightTask[]
  cupImports         CupImport[]
  oauthClientsRegistered OAuthClient[] @relation("OAuthClientRegisteredBy")
  oauthClientsReviewed   OAuthClient[] @relation("OAuthClientReviewedBy")
  oauthGrants            OAuthGrant[]
  oauthIdempotencyRecords OAuthIdempotencyRecord[]
  authenticityKeys        AuthenticityKey[]
  authenticitySubmissions FlightAuthenticitySubmission[] @relation("AuthenticitySubmittedBy")
  authenticityReviews     FlightAuthenticitySubmission[] @relation("AuthenticityReviewedBy")
  journalEntries          JournalEntry[]
}

model JournalEntry {
  id         String   @id @default(cuid())
  userId     String
  title      String
  body       String
  occurredAt DateTime
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  images JournalImage[]

  @@unique([id, userId])
  @@index([userId, occurredAt, id])
}

model JournalImage {
  id         String   @id @default(cuid())
  entryId    String
  userId     String
  storageKey String   @unique
  sizeBytes  Int
  width      Int
  height     Int
  createdAt  DateTime @default(now())

  entry JournalEntry @relation(fields: [entryId, userId], references: [id, userId], onDelete: Cascade)

  @@index([entryId, createdAt])
  @@index([userId])
}

model FlightSegment {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  startLat    Float
  startLon    Float
  finishLat   Float
  finishLon   Float
  gateRadiusM Int      @default(500)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  results FlightSegmentResult[]

  @@index([active, name])
}

model FlightSegmentResult {
  id              String   @id @default(cuid())
  segmentId       String
  flightId        String
  userId          String
  startSeq        Int
  finishSeq       Int
  durationSeconds Int
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  segment FlightSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  flight  Flight        @relation(fields: [flightId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([segmentId, flightId])
  @@index([segmentId, durationSeconds])
  @@index([userId, createdAt])
  @@index([flightId])
}

model FlightTask {
  id              String         @id @default(cuid())
  lineageId       String         @default(cuid())
  revision        Int            @default(1)
  packageDownloads Int           @default(0)
  ownerId         String
  name            String
  description     String?
  visibility      TaskVisibility @default(PRIVATE)
  totalDistanceKm Float          @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  owner     User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  waypoints TaskWaypoint[]

  @@index([ownerId, updatedAt])
  @@index([ownerId, createdAt, id])
  @@index([visibility, updatedAt])
  @@index([lineageId, revision])
}

model TaskWaypoint {
  id        String @id @default(cuid())
  taskId    String
  seq       Int
  name      String?
  code      String?
  lat       Float
  lon       Float
  radiusM   Int    @default(500)

  task FlightTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, seq])
  @@index([taskId, seq])
}

model CupImport {
  id         String   @id @default(cuid())
  ownerId    String
  sourceName String
  sha256     String
  createdAt  DateTime @default(now())

  owner     User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  waypoints ImportedWaypoint[]

  @@unique([ownerId, sha256])
  @@index([ownerId, createdAt])
}

model ImportedWaypoint {
  id         String  @id @default(cuid())
  importId   String
  seq        Int
  name       String
  code       String?
  country    String?
  lat        Float
  lon        Float
  elevationM Float?
  style      Int?
  description String?

  cupImport CupImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, seq])
  @@index([importId, seq])
  @@index([name])
  @@index([code])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model OAuthClient {
  id                 String            @id @default(cuid())
  clientId           String            @unique
  name               String
  description        String?
  redirectUris       String[]
  allowedScopes      String[]
  status             OAuthClientStatus @default(PENDING)
  consentRequired    Boolean           @default(true)
  registeredByUserId String
  reviewedByUserId   String?
  reviewedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  registeredBy      User                     @relation("OAuthClientRegisteredBy", fields: [registeredByUserId], references: [id], onDelete: Restrict)
  reviewedBy        User?                    @relation("OAuthClientReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  grants            OAuthGrant[]
  idempotencyRecords OAuthIdempotencyRecord[]
  authenticityKeys  AuthenticityKey[]
  authenticitySubmissions FlightAuthenticitySubmission[]

  @@index([status, name])
}

model OAuthGrant {
  id            String   @id @default(cuid())
  userId        String
  oauthClientId String
  scopes        String[]
  grantedAt     DateTime @default(now())
  lastUsedAt    DateTime @default(now())
  revokedAt     DateTime?

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client OAuthClient @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)

  @@unique([userId, oauthClientId])
  @@index([userId, revokedAt])
  @@index([oauthClientId, revokedAt])
}

model OAuthIdempotencyRecord {
  id             String   @id @default(cuid())
  oauthClientId  String
  userId         String
  key            String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  client OAuthClient @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([oauthClientId, userId, key])
  @@index([expiresAt])
}

model AuthenticityKey {
  id            String   @id @default(cuid())
  userId        String
  oauthClientId String
  keyId         String
  publicKeyJwk  Json
  fingerprint   String
  createdAt     DateTime @default(now())
  revokedAt     DateTime?

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client OAuthClient @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)

  @@unique([userId, oauthClientId, keyId])
  @@index([oauthClientId, revokedAt])
  @@index([fingerprint])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model PilotProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  callsign               String   @unique
  homeAirfield           String?
  favoriteSim            String?
  favoriteGlider         String?
  country                String?
  bio                    String?
  showHomeAirfieldOnHome Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BadgeDefinition {
  id          String   @id
  code        String   @unique
  name        String
  description String
  icon        String
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       UserBadge[]

  @@index([enabled, sortOrder])
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge BadgeDefinition @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId, awardedAt])
  @@index([badgeId])
}

model Club {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  memberships ClubMembership[]
  leagues      League[]

  @@index([name])
}

model ClubMembership {
  id       String         @id @default(cuid())
  clubId   String
  userId   String
  role     ClubMemberRole @default(MEMBER)
  joinedAt DateTime       @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([clubId, role])
  @@index([userId])
  @@index([userId, joinedAt, id])
}

model Competition {
  id               String                 @id @default(cuid())
  slug             String                 @unique
  name             String
  description      String?
  rules            String?
  startAt          DateTime
  endAt            DateTime
  status           CompetitionStatus      @default(DRAFT)
  scoringRule      CompetitionScoringRule @default(OLC_POINTS)
  simulator        String?
  competitionClass String?
  evidenceRequired Boolean                @default(false)
  evidenceSimulators String[]             @default([])
  requiredEvidenceFields String[]         @default([])
  requireSignedEvidence Boolean           @default(false)
  requiredTaskPackageId String?
  closedAt         DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  entries          CompetitionEntry[]

  @@index([status, startAt, endAt])
  @@index([endAt])
}

model CompetitionEntry {
  id            String   @id @default(cuid())
  competitionId String
  flightId      String
  userId        String
  score         Float
  assignedAt    DateTime @default(now())

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  flight      Flight      @relation(fields: [flightId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([competitionId, flightId])
  @@index([competitionId, score])
  @@index([competitionId, userId])
  @@index([flightId])
  @@index([userId, assignedAt, id])
}

model League {
  id             String                 @id @default(cuid())
  slug           String                 @unique
  name           String
  description    String?
  mode           LeagueMode
  scope          LeagueScope            @default(GLOBAL)
  clubId         String?
  startDayUtc    Int                    @default(1)
  startHourUtc   Int                    @default(0)
  durationHours  Int                    @default(168)
  scoringRule    CompetitionScoringRule @default(OLC_POINTS)
  active         Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  club   Club?         @relation(fields: [clubId], references: [id], onDelete: SetNull)
  rounds LeagueRound[]

  @@index([active, mode])
  @@index([clubId])
}

model LeagueRound {
  id        String            @id @default(cuid())
  leagueId  String
  startsAt  DateTime
  endsAt    DateTime
  status    LeagueRoundStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  closedAt  DateTime?

  league  League             @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  entries LeagueRoundEntry[]

  @@unique([leagueId, startsAt])
  @@index([leagueId, status, startsAt])
  @@index([endsAt])
}

model LeagueRoundEntry {
  id        String   @id @default(cuid())
  roundId   String
  flightId  String
  userId    String
  score     Float
  createdAt DateTime @default(now())

  round  LeagueRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  flight Flight      @relation(fields: [flightId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roundId, flightId])
  @@index([roundId, score])
  @@index([roundId, userId])
  @@index([flightId])
  @@index([userId, createdAt, id])
}

model Flight {
  id                String                 @id @default(cuid())
  userId            String
  pilotCallsign     String
  title             String
  simulator         String
  glider            String?
  registration      String?
  competitionClass  String?
  weatherMode       String                 @default("UNKNOWN")
  comment           String?
  storyText         String?
  visibility        FlightVisibility       @default(PUBLIC)
  publicIgcDownloadEnabled Boolean         @default(false)
  moderationStatus  FlightModerationStatus @default(APPROVED)
  moderatedByUserId String?
  moderatedAt       DateTime?
  moderationNote    String?
  deletedAt         DateTime?
  deletedByUserId   String?
  igcObjectPath     String
  igcSha256         String                 @unique
  startTime         DateTime?
  durationSeconds   Int
  distanceKm        Float
  olcPoints         Float
  scoringRule       String                 @default("LEGACY_DISTANCE_1_8")
  scoringDistanceKm Float                  @default(0)
  scoringMultiplier Float                  @default(1.8)
  scoringClosedCourse Boolean              @default(false)
  suggestedScoringStartSeq Int?
  suggestedScoringEndSeq   Int?
  scoringStartSeq          Int?
  scoringEndSeq            Int?
  scoringWindowMode        ScoringWindowMode @default(AUTO)
  scoringWindowReasons     String[]          @default([])
  avgSpeedKmh       Float
  maxAltitudeM      Int
  minAltitudeM      Int
  maxVarioMs        Float
  startLat          Float?
  startLon          Float?
  finishLat         Float?
  finishLon         Float?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  track    TrackPoint[]
  thermals Thermal[]
  glidePhases GlidePhase[]
  likes    FlightLike[]
  comments FlightComment[]
  notifications Notification[]
  scoringPoints FlightScoringPoint[]
  storyImages FlightStoryImage[]
  competitionEntries CompetitionEntry[]
  leagueEntries      LeagueRoundEntry[]
  segmentResults     FlightSegmentResult[]
  authenticitySubmissions FlightAuthenticitySubmission[]

  @@index([visibility, createdAt])
  @@index([visibility, moderationStatus, createdAt])
  @@index([visibility, moderationStatus, olcPoints])
  @@index([moderationStatus, createdAt])
  @@index([deletedAt])
  @@index([userId, createdAt])
}

model FlightAuthenticitySubmission {
  id                  String             @id @default(cuid())
  flightId            String
  userId              String
  oauthClientId       String
  revision            Int
  status              AuthenticityStatus
  evidenceVersion     String
  evidenceSha256      String
  simulatorVersion    String?
  taskPackageId       String?
  taskPackageSha256   String?
  attemptId           String?
  signed              Boolean            @default(false)
  signatureValid      Boolean?
  signingKeyId        String?
  evidenceSummary     Json
  findings            Json
  appealStatus        AuthenticityAppealStatus?
  appealText          String?
  appealedAt          DateTime?
  appealResolution    String?
  appealReviewedAt    DateTime?
  appealReviewedByUserId String?
  createdAt           DateTime           @default(now())

  flight           Flight      @relation(fields: [flightId], references: [id], onDelete: Cascade)
  user             User        @relation("AuthenticitySubmittedBy", fields: [userId], references: [id], onDelete: Cascade)
  client           OAuthClient @relation(fields: [oauthClientId], references: [id], onDelete: Restrict)
  appealReviewedBy User?       @relation("AuthenticityReviewedBy", fields: [appealReviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([flightId, revision])
  @@index([flightId, createdAt])
  @@index([userId, attemptId])
  @@index([status, createdAt])
}

model TrackPoint {
  id       String    @id @default(cuid())
  flightId String
  seq      Int
  time     DateTime?
  lat      Float
  lon      Float
  altM     Int
  varioMs  Float?

  flight Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@unique([flightId, seq])
  @@index([flightId, seq])
}

model FlightScoringPoint {
  id            String @id @default(cuid())
  flightId      String
  order         Int
  trackSeq      Int
  lat           Float
  lon           Float
  legDistanceKm Float

  flight Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@unique([flightId, order])
  @@index([flightId, order])
}

model Thermal {
  id          String    @id @default(cuid())
  flightId    String
  seq         Int
  startSeq    Int?
  endSeq      Int?
  startTime   DateTime?
  endTime     DateTime?
  centerLat   Float?
  centerLon   Float?
  avgClimbMs  Float
  maxClimbMs  Float
  gainM       Int
  durationSec Int
  efficiencyPercent Float @default(0)
  windDirectionDeg  Int?
  windSpeedKmh      Float?
  windConfidence    WindEstimateConfidence?
  windDriftDistanceM Int?

  flight Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@unique([flightId, seq])
  @@index([flightId, seq])
}

model GlidePhase {
  id          String    @id @default(cuid())
  flightId    String
  seq         Int
  startSeq    Int
  endSeq      Int
  startTime   DateTime?
  endTime     DateTime?
  durationSec Int
  distanceKm  Float
  avgSpeedKmh Float
  avgSinkMs   Float
  glideRatio  Float

  flight Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@unique([flightId, seq])
  @@index([flightId, seq])
}

model Airspace {
  id           String   @id @default(cuid())
  name         String
  className    String
  floorLabel   String
  ceilingLabel String
  sourceName   String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  importedByUserId String
  minLat       Float
  maxLat       Float
  minLon       Float
  maxLon       Float
  points       AirspacePoint[]

  @@index([active, createdAt])
  @@index([active, minLat, maxLat])
  @@index([active, minLon, maxLon])
}

model AirspacePoint {
  id         String @id @default(cuid())
  airspaceId String
  seq        Int
  lat        Float
  lon        Float

  airspace Airspace @relation(fields: [airspaceId], references: [id], onDelete: Cascade)

  @@unique([airspaceId, seq])
  @@index([airspaceId, seq])
}

model FlightStoryImage {
  id         String   @id @default(cuid())
  flightId   String
  objectPath String
  fileName   String
  mimeType   String
  sizeBytes  Int
  sha256     String
  createdAt  DateTime @default(now())
  uploadedByUserId String

  flight Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@unique([flightId, sha256])
  @@index([flightId, createdAt])
}

model UserPreference {
  id                       String                    @id @default(cuid())
  userId                   String                    @unique
  theme                    ThemePreference           @default(SYSTEM)
  preferredSimulator       String                    @default("MSFS 2024")
  unitSystem               UnitSystemPreference      @default(METRIC)
  preferredLeaderboardView LeaderboardViewPreference @default(ALL)
  preferredMapMode         MapModePreference         @default(STANDARD)
  homeFeedMode             HomeFeedMode              @default(PUBLIC)
  homeFeedSimulator        String?
  homeFeedCompetitionClass String?
  navigationSide           String                    @default("LEFT")
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PilotFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("PilotFollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("PilotFollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
}

model FlightLike {
  id        String   @id @default(cuid())
  flightId  String
  userId    String
  createdAt DateTime @default(now())

  flight Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([flightId, userId])
  @@index([userId, createdAt])
}

model FlightComment {
  id              String   @id @default(cuid())
  flightId        String
  userId          String
  content         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
  deletedByUserId String?

  flight  Flight                @relation(fields: [flightId], references: [id], onDelete: Cascade)
  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports FlightCommentReport[]
  notifications Notification[]

  @@index([flightId, createdAt])
  @@index([userId, createdAt])
  @@index([deletedAt])
}

model FlightCommentReport {
  id         String   @id @default(cuid())
  commentId  String
  reporterId String
  reason     String?
  createdAt  DateTime @default(now())

  comment  FlightComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter User          @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([commentId, reporterId])
  @@index([createdAt])
}

model Notification {
  id               String           @id @default(cuid())
  userId           String
  actorUserId      String?
  type             NotificationType
  flightId         String?
  commentId        String?
  moderationStatus String?
  readAt           DateTime?
  createdAt        DateTime         @default(now())

  user    User           @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor   User?          @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  flight  Flight?        @relation(fields: [flightId], references: [id], onDelete: SetNull)
  comment FlightComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([flightId])
}

model UploadBatch {
  id        String            @id @default(cuid())
  userId    String
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     UploadBatchItem[]

  @@index([userId, createdAt])
}

model UploadBatchItem {
  id               String                @id @default(cuid())
  batchId          String
  originalFileName String
  status           UploadBatchItemStatus
  errorCode        String?
  flightId         String?
  createdAt        DateTime              @default(now())
  batch            UploadBatch           @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, createdAt])
}

model AuditLog {
  id          String      @id @default(cuid())
  actorUserId String?
  actorEmail  String?
  action      AuditAction
  targetType  String
  targetId    String?
  summary     String
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
}

model IgcUploadBlock {
  id                    String   @id @default(cuid())
  igcSha256             String   @unique
  originalFlightId      String?
  originalTitle         String?
  originalPilotCallsign String?
  reason                String   @default("deleted-flight")
  blockedAt             DateTime @default(now())
  blockedByUserId       String?

  @@index([blockedAt])
  @@index([originalFlightId])
}
