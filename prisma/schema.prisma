generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum FlightVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum SimSoarRole {
  USER
  PILOT
  MODERATOR
  ADMIN
  OWNER
}

enum FlightModerationStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

enum UnitSystemPreference {
  METRIC
  IMPERIAL
}

enum LeaderboardViewPreference {
  ALL
  MSFS
  CONDOR
  XPLANE
}

enum MapModePreference {
  STANDARD
  SATELLITE
  TERRAIN
}

enum AuditAction {
  USER_ROLE_SYNC
  USER_ROLE_UPDATE
  USER_UPDATE
  USER_DELETE
  PILOT_PROFILE_UPDATE
  FLIGHT_UPLOAD
  FLIGHT_UPDATE
  FLIGHT_APPROVE
  FLIGHT_REJECT
  FLIGHT_HIDE
  FLIGHT_DELETE
  FLIGHT_PURGE
  FLIGHT_RESTORE
  FLIGHT_IGC_REPLACE
  IGC_UPLOAD_UNBLOCK
  IGC_DOWNLOAD
  PREFERENCE_UPDATE
  PILOT_FOLLOW
  PILOT_UNFOLLOW
  FLIGHT_LIKE
  FLIGHT_UNLIKE
  FLIGHT_COMMENT_CREATE
  FLIGHT_COMMENT_DELETE
  FLIGHT_COMMENT_REPORT
}

enum HomeFeedMode {
  PUBLIC
  OWN
  FOLLOWING
}

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String?         @unique
  emailVerified  DateTime?
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  roles          SimSoarRole[]   @default([USER, PILOT])
  accounts       Account[]
  sessions       Session[]
  authenticators Authenticator[]
  profile        PilotProfile?
  preferences    UserPreference?
  flights        Flight[]
  following      PilotFollow[]    @relation("PilotFollowFollower")
  followers      PilotFollow[]    @relation("PilotFollowFollowing")
  flightLikes    FlightLike[]
  flightComments FlightComment[]
  commentReports FlightCommentReport[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model PilotProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  callsign               String   @unique
  homeAirfield           String?
  favoriteSim            String?
  favoriteGlider         String?
  country                String?
  bio                    String?
  showHomeAirfieldOnHome Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Flight {
  id                String                 @id @default(cuid())
  userId            String
  pilotCallsign     String
  title             String
  simulator         String
  glider            String?
  registration      String?
  competitionClass  String?
  weatherMode       String                 @default("UNKNOWN")
  comment           String?
  visibility        FlightVisibility       @default(PUBLIC)
  publicIgcDownloadEnabled Boolean         @default(false)
  moderationStatus  FlightModerationStatus @default(APPROVED)
  moderatedByUserId String?
  moderatedAt       DateTime?
  moderationNote    String?
  deletedAt         DateTime?
  deletedByUserId   String?
  igcObjectPath     String
  igcSha256         String                 @unique
  startTime         DateTime?
  durationSeconds   Int
  distanceKm        Float
  olcPoints         Float
  avgSpeedKmh       Float
  maxAltitudeM      Int
  minAltitudeM      Int
  maxVarioMs        Float
  startLat          Float?
  startLon          Float?
  finishLat         Float?
  finishLon         Float?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  track    TrackPoint[]
  thermals Thermal[]
  likes    FlightLike[]
  comments FlightComment[]

  @@index([visibility, createdAt])
  @@index([visibility, moderationStatus, createdAt])
  @@index([visibility, moderationStatus, olcPoints])
  @@index([moderationStatus, createdAt])
  @@index([deletedAt])
  @@index([userId, createdAt])
}

model TrackPoint {
  id       String    @id @default(cuid())
  flightId String
  seq      Int
  time     DateTime?
  lat      Float
  lon      Float
  altM     Int
  varioMs  Float?

  flight Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@unique([flightId, seq])
  @@index([flightId, seq])
}

model Thermal {
  id          String    @id @default(cuid())
  flightId    String
  seq         Int
  startTime   DateTime?
  endTime     DateTime?
  centerLat   Float?
  centerLon   Float?
  avgClimbMs  Float
  maxClimbMs  Float
  gainM       Int
  durationSec Int

  flight Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@unique([flightId, seq])
  @@index([flightId, seq])
}

model UserPreference {
  id                       String                    @id @default(cuid())
  userId                   String                    @unique
  theme                    ThemePreference           @default(SYSTEM)
  preferredSimulator       String                    @default("MSFS 2024")
  unitSystem               UnitSystemPreference      @default(METRIC)
  preferredLeaderboardView LeaderboardViewPreference @default(ALL)
  preferredMapMode         MapModePreference         @default(STANDARD)
  homeFeedMode             HomeFeedMode              @default(PUBLIC)
  homeFeedSimulator        String?
  homeFeedCompetitionClass String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PilotFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("PilotFollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("PilotFollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
}

model FlightLike {
  id        String   @id @default(cuid())
  flightId  String
  userId    String
  createdAt DateTime @default(now())

  flight Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([flightId, userId])
  @@index([userId, createdAt])
}

model FlightComment {
  id              String   @id @default(cuid())
  flightId        String
  userId          String
  content         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
  deletedByUserId String?

  flight  Flight                @relation(fields: [flightId], references: [id], onDelete: Cascade)
  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports FlightCommentReport[]

  @@index([flightId, createdAt])
  @@index([userId, createdAt])
  @@index([deletedAt])
}

model FlightCommentReport {
  id         String   @id @default(cuid())
  commentId  String
  reporterId String
  reason     String?
  createdAt  DateTime @default(now())

  comment  FlightComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter User          @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([commentId, reporterId])
  @@index([createdAt])
}

model AuditLog {
  id          String      @id @default(cuid())
  actorUserId String?
  actorEmail  String?
  action      AuditAction
  targetType  String
  targetId    String?
  summary     String
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
}

model IgcUploadBlock {
  id                    String   @id @default(cuid())
  igcSha256             String   @unique
  originalFlightId      String?
  originalTitle         String?
  originalPilotCallsign String?
  reason                String   @default("deleted-flight")
  blockedAt             DateTime @default(now())
  blockedByUserId       String?

  @@index([blockedAt])
  @@index([originalFlightId])
}
