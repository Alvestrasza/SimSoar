generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum FlightVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum SimSoarRole {
  USER
  PILOT
  MODERATOR
  ADMIN
  OWNER
}

enum FlightModerationStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum AuditAction {
  USER_ROLE_SYNC
  USER_UPDATE
  USER_DELETE
  PILOT_PROFILE_UPDATE
  FLIGHT_UPLOAD
  FLIGHT_APPROVE
  FLIGHT_REJECT
  FLIGHT_HIDE
  FLIGHT_DELETE
  PREFERENCE_UPDATE
}

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String?         @unique
  emailVerified  DateTime?
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  roles          SimSoarRole[]   @default([USER])
  accounts       Account[]
  sessions       Session[]
  authenticators Authenticator[]
  profile        PilotProfile?
  flights        Flight[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model PilotProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  callsign               String   @unique
  homeAirfield           String?
  favoriteSim            String?
  favoriteGlider         String?
  country                String?
  bio                    String?
  showHomeAirfieldOnHome Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Flight {
  id               String           @id @default(cuid())
  userId           String
  pilotCallsign    String
  title            String
  simulator        String
  glider           String?
  registration     String?
  competitionClass String?
  comment          String?
  visibility       FlightVisibility @default(PUBLIC)
  moderationStatus   FlightModerationStatus   @default(APPROVED)
  moderatedByUserId  String?
  moderatedAt        DateTime?
  moderationNote     String?
  deletedAt          DateTime?
  deletedByUserId    String?
  igcObjectPath    String
  igcSha256        String
  startTime        DateTime?
  durationSeconds  Int
  distanceKm       Float
  olcPoints        Float
  avgSpeedKmh      Float
  maxAltitudeM     Int
  minAltitudeM     Int
  maxVarioMs       Float
  startLat         Float?
  startLon         Float?
  finishLat        Float?
  finishLon        Float?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  track    TrackPoint[]
  thermals Thermal[]

  @@index([visibility, createdAt])
  @@index([visibility, moderationStatus, createdAt])
  @@index([visibility, moderationStatus, olcPoints])
  @@index([moderationStatus, createdAt])
  @@index([deletedAt])
  @@index([userId, createdAt])
}

model TrackPoint {
  id       String    @id @default(cuid())
  flightId String
  seq      Int
  time     DateTime?
  lat      Float
  lon      Float
  altM     Int
  varioMs  Float?

  flight Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@unique([flightId, seq])
  @@index([flightId, seq])
}

model Thermal {
  id          String    @id @default(cuid())
  flightId    String
  seq         Int
  startTime   DateTime?
  endTime     DateTime?
  centerLat   Float?
  centerLon   Float?
  avgClimbMs  Float
  maxClimbMs  Float
  gainM       Int
  durationSec Int

  flight Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@unique([flightId, seq])
  @@index([flightId, seq])
}

model AuditLog {
  id          String      @id @default(cuid())
  actorUserId String?
  actorEmail  String?
  action      AuditAction
  targetType  String
  targetId    String?
  summary     String
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
}
