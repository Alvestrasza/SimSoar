# Public OAuth resource-server configuration. Do not commit real secrets.
AUTH_KEYCLOAK_ISSUER=https://identity.example/realms/simsoar
# Optional; defaults to the dedicated resource audience below.
SIMSOAR_OAUTH_AUDIENCE=simsoar-api
# Optional. When omitted, SimSoar uses the issuer's Keycloak certificate endpoint.
# SIMSOAR_OAUTH_JWKS_URI=https://identity.example/realms/simsoar/protocol/openid-connect/certs
